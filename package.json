{
	"name": "mapcheckr-cli",
	"version": "1.1.0",
	"description": "Fast Geoguessr map checker — same defaults as mapcheckr.vercel.app, runs against the reverse-engineered Google Street View metadata endpoints. No headless browser, no API key.",
	"type": "module",
	"bin": {
		"mapcheckr": "cli.js"
	},
	"main": "./cli.js",
	"files": [
		"cli.js",
		"lib/",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"start": "node ./cli.js",
		"smoke": "node ./cli.js --help"
	},
	"keywords": [
		"geoguessr",
		"streetview",
		"mapcheckr",
		"google-maps",
		"street-view",
		"cli"
	],
	"author": "Gautam Anand <gautamgxtv@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/codergautam/mapcheckr-lagfixes.git"
	},
	"bugs": {
		"url": "https://github.com/codergautam/mapcheckr-lagfixes/issues"
	},
	"homepage": "https://github.com/codergautam/mapcheckr-lagfixes#readme",
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"chalk": "^5.3.0",
		"commander": "^12.1.0"
	}
}
